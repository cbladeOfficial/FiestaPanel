#!/usr/bin/env bash
# ==============================================================================
# GatewayPanel CLI Management Utility (panelctl)
# Version: 1.0.0
# Description: Command-line control interface for GatewayPanel Server Software
# ==============================================================================

set -e

# Detect Panel Directory
PANEL_DIR="/opt/gateway-panel"
if [ ! -d "$PANEL_DIR" ]; then
    # Check current script directory
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    if [ -f "$SCRIPT_DIR/app.py" ]; then
        PANEL_DIR="$SCRIPT_DIR"
    elif [ -d "/home/ubuntu/fiesta-portal" ]; then
        PANEL_DIR="/home/ubuntu/fiesta-portal"
    fi
fi

# Detect Service Name
SERVICE_NAME="gateway-panel"
if systemctl list-units --full -all | grep -Fq "fiesta-portal.service"; then
    SERVICE_NAME="fiesta-portal"
elif ! systemctl list-units --full -all | grep -Fq "gateway-panel.service"; then
    SERVICE_NAME="fiesta-portal"
fi

COLOR_RESET="\033[0m"
COLOR_GREEN="\033[1;32m"
COLOR_CYAN="\033[1;36m"
COLOR_YELLOW="\033[1;33m"
COLOR_RED="\033[1;31m"

print_banner() {
    echo -e "${COLOR_CYAN}"
    echo "  ╔═══════════════════════════════════════════════════════════════╗"
    echo "  ║        GatewayPanel - Server Software Management CLI          ║"
    echo "  ╚═══════════════════════════════════════════════════════════════╝"
    echo -e "${COLOR_RESET}"
}

cmd_help() {
    print_banner
    echo "Usage: panelctl [COMMAND] [ARGS]"
    echo ""
    echo "Service Commands:"
    echo "  start               Start GatewayPanel system daemon"
    echo "  stop                Stop GatewayPanel system daemon"
    echo "  restart             Restart GatewayPanel system daemon"
    echo "  status              View daemon operational status"
    echo "  logs                Stream live log output (Ctrl+C to exit)"
    echo ""
    echo "Configuration Commands:"
    echo "  reset-admin [PASS]  Reset or change the admin user password"
    echo "  set-port [PORT]     Update web listener port (e.g. 8080)"
    echo "  set-mc-path [PATH]  Update Minecraft server root directory"
    echo "  info                Display panel environment & active settings"
    echo "  version             Display version information"
    echo ""
}

require_root() {
    if [ "$EUID" -ne 0 ]; then
        echo -e "${COLOR_RED}Error: This command requires superuser privileges. Please re-run with sudo.${COLOR_RESET}"
        exit 1
    fi
}

cmd_start() {
    require_root
    echo -e "${COLOR_CYAN}Starting $SERVICE_NAME service...${COLOR_RESET}"
    systemctl start "$SERVICE_NAME"
    echo -e "${COLOR_GREEN}✓ $SERVICE_NAME started successfully.${COLOR_RESET}"
}

cmd_stop() {
    require_root
    echo -e "${COLOR_YELLOW}Stopping $SERVICE_NAME service...${COLOR_RESET}"
    systemctl stop "$SERVICE_NAME"
    echo -e "${COLOR_GREEN}✓ $SERVICE_NAME stopped.${COLOR_RESET}"
}

cmd_restart() {
    require_root
    echo -e "${COLOR_CYAN}Restarting $SERVICE_NAME service...${COLOR_RESET}"
    systemctl restart "$SERVICE_NAME"
    echo -e "${COLOR_GREEN}✓ $SERVICE_NAME restarted successfully.${COLOR_RESET}"
}

cmd_status() {
    systemctl status "$SERVICE_NAME" --no-pager
}

cmd_logs() {
    journalctl -u "$SERVICE_NAME" -f -n 50
}

cmd_reset_admin() {
    require_root
    NEW_PASS="$1"
    if [ -z "$NEW_PASS" ]; then
        read -rsp "Enter new admin password: " NEW_PASS
        echo ""
        read -rsp "Confirm new admin password: " CONFIRM_PASS
        echo ""
        if [ "$NEW_PASS" != "$CONFIRM_PASS" ]; then
            echo -e "${COLOR_RED}Error: Passwords do not match.${COLOR_RESET}"
            exit 1
        fi
    fi

    if [ -z "$NEW_PASS" ]; then
        echo -e "${COLOR_RED}Error: Password cannot be blank.${COLOR_RESET}"
        exit 1
    fi

    python3 -c "
import json, hashlib, os

users_file = os.path.join('$PANEL_DIR', 'users.json')
users = {}
if os.path.exists(users_file):
    try:
        with open(users_file, 'r') as f:
            users = json.load(f)
    except:
        pass

p_hash = hashlib.sha256('$NEW_PASS'.encode('utf-8')).hexdigest()

admin_found = False
for u, data in users.items():
    if data.get('role') == 'owner' or u == 'admin':
        data['password_hash'] = p_hash
        data['status'] = 'active'
        admin_found = True
        break

if not admin_found:
    users['admin'] = {
        'username': 'admin',
        'password_hash': p_hash,
        'role': 'owner',
        'permissions': ['all'],
        'created_at': '2026-11-02 12:00:00',
        'status': 'active'
    }

with open(users_file, 'w') as f:
    json.dump(users, f, indent=2)

print('Admin password hash updated successfully.')
"
    echo -e "${COLOR_GREEN}✓ Admin password successfully reset.${COLOR_RESET}"
    systemctl restart "$SERVICE_NAME" || true
}

cmd_set_port() {
    require_root
    PORT="$1"
    if [ -z "$PORT" ]; then
        echo -e "${COLOR_RED}Usage: panelctl set-port <port-number>${COLOR_RESET}"
        exit 1
    fi

    CONFIG_FILE="$PANEL_DIR/config.json"
    python3 -c "
import json, os

cfg_file = '$CONFIG_FILE'
cfg = {}
if os.path.exists(cfg_file):
    try:
        with open(cfg_file, 'r') as f:
            cfg = json.load(f)
    except:
        pass

cfg['port'] = int('$PORT')

with open(cfg_file, 'w') as f:
    json.dump(cfg, f, indent=2)

print('Port updated in configuration.')
"
    echo -e "${COLOR_GREEN}✓ Port updated to $PORT. Restarting service...${COLOR_RESET}"
    systemctl restart "$SERVICE_NAME"
    echo -e "${COLOR_GREEN}✓ Service restarted on port $PORT.${COLOR_RESET}"
}

cmd_set_mc_path() {
    require_root
    MC_PATH="$1"
    if [ -z "$MC_PATH" ]; then
        echo -e "${COLOR_RED}Usage: panelctl set-mc-path /path/to/minecraft${COLOR_RESET}"
        exit 1
    fi

    if [ ! -d "$MC_PATH" ]; then
        echo -e "${COLOR_YELLOW}Warning: Directory $MC_PATH does not currently exist. Proceeding anyway.${COLOR_RESET}"
    fi

    CONFIG_FILE="$PANEL_DIR/config.json"
    python3 -c "
import json, os

cfg_file = '$CONFIG_FILE'
cfg = {}
if os.path.exists(cfg_file):
    try:
        with open(cfg_file, 'r') as f:
            cfg = json.load(f)
    except:
        pass

cfg['server_dir'] = '$MC_PATH'

with open(cfg_file, 'w') as f:
    json.dump(cfg, f, indent=2)

print('Minecraft server directory updated.')
"
    echo -e "${COLOR_GREEN}✓ Minecraft server path updated to: $MC_PATH${COLOR_RESET}"
    systemctl restart "$SERVICE_NAME"
}

cmd_info() {
    print_banner
    echo -e "${COLOR_CYAN}Installation Directory:${COLOR_RESET} $PANEL_DIR"
    echo -e "${COLOR_CYAN}Systemd Service:${COLOR_RESET}        $SERVICE_NAME.service"
    echo -e "${COLOR_CYAN}Daemon Active Status:${COLOR_RESET}   $(systemctl is-active "$SERVICE_NAME" 2>/dev/null || echo "inactive")"
    
    if [ -f "$PANEL_DIR/config.json" ]; then
        echo -e "${COLOR_CYAN}Configuration File:${COLOR_RESET}     $PANEL_DIR/config.json"
        cat "$PANEL_DIR/config.json"
    fi
}

cmd_version() {
    echo "GatewayPanel Software Suite v2.0.0"
}

# Main Command Router
case "$1" in
    start)
        cmd_start
        ;;
    stop)
        cmd_stop
        ;;
    restart)
        cmd_restart
        ;;
    status)
        cmd_status
        ;;
    logs)
        cmd_logs
        ;;
    reset-admin)
        cmd_reset_admin "$2"
        ;;
    set-port)
        cmd_set_port "$2"
        ;;
    set-mc-path)
        cmd_set_mc_path "$2"
        ;;
    info)
        cmd_info
        ;;
    version|-v|--version)
        cmd_version
        ;;
    help|-h|--help|"")
        cmd_help
        ;;
    *)
        echo -e "${COLOR_RED}Unknown command: $1${COLOR_RESET}"
        cmd_help
        exit 1
        ;;
esac
